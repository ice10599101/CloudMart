// CloudMart 社区宠物 · 材质着色器（视觉重构 v4）—— 对齐参考图的"柔和毛绒/软陶质感"。
//
// 风格依据（参考图分析）：
//  - 参考图没有硬描边，靠"体积光 + 边缘绒光 + 柔和的明暗过渡"塑造可爱感；
//  - 暗部不是灰黑，而是同色系压暗后再抬一点（避免脏）；
//  - 毛绒物种（猫/狗/兔/仓鼠）边缘有绒毛透光的亮边；
//  - 光滑物种（乌龟/猪）有清晰的高光点（塑料/陶瓷湿润感）。
//
// 因此本版提供四组可控参数：
//  1) 明暗：半兰伯特 + 加宽羽化的 smoothstep（柔和渐变，不再是硬色阶）；
//  2) 天光：顶部提亮，让圆润形体有上亮下暗的球体感；
//  3) 绒光：菲涅尔边缘提亮（furCtrl.x/y），毛绒物种调高、光滑物种调低；
//  4) 高光：Blinn-Phong 点高光（furCtrl.z/w），光滑物种调高。
//  描边 pass 保留但默认极细（outlineCtrl.x 由 JS 侧下发，可为 0）。
//
// 零外部资产：纯文本 effect，随工程构建打包；运行时 EffectAsset.get('pet-toon') 取用。

CCEffect %{
  techniques:
  - name: opaque
    passes:
    # Pass 1：描边（背面外扩壳；outlineCtrl.x = 0 时视觉上不可见）
    - &outline-pass
      vert: pet-outline-vs:vert
      frag: pet-outline-fs:frag
      rasterizerState: { cullMode: front }
      depthStencilState: { depthFunc: less_equal, depthTest: true, depthWrite: true }
      properties: &outline-props
        # x: 模型空间外扩宽度（JS 侧按部件半径下发）
        outlineCtrl:  { value: [0.006, 0.0, 0.0, 0.0] }
        outlineColor: { value: [0.26, 0.20, 0.26, 1.0], linear: true, editor: { type: color } }
    # Pass 2：主体着色
    - &main-pass
      vert: pet-toon-vs:vert
      frag: pet-toon-fs:frag
      depthStencilState: { depthTest: true, depthWrite: true }
      properties: &props
        mainColor:  { value: [1.0, 1.0, 1.0, 1.0],  linear: true, editor: { type: color } }
        # 暗部色（JS 侧由主色推导下发）
        shadeColor: { value: [0.70, 0.66, 0.72, 1.0], linear: true, editor: { type: color } }
        # 世界空间光照方向（偏顶部：形成"上亮下暗"的体积感，避免正面一片死白）
        lightDir:   { value: [0.32, 0.88, 0.34, 0.0] }
        # x: 明暗分界阈值  y: 羽化宽度（越大约柔和）  z: 轮廓光强度  w: 顶部提亮强度
        shadeCtrl:  { value: [0.52, 0.30, 0.26, 0.14] }
        rimColor:   { value: [1.0, 0.97, 0.92, 1.0], linear: true, editor: { type: color } }
        # 绒光颜色（毛绒边缘散射：偏白暖色）
        furColor:   { value: [1.0, 0.98, 0.95, 1.0], linear: true, editor: { type: color } }
        # x: 绒光强度  y: 绒光锐度  z: 高光强度  w: 高光锐度
        furCtrl:    { value: [0.16, 1.7, 0.06, 26.0] }
  # 半透明技术：腮红 / 影子 / 光斑
  - name: transparent
    passes:
    - vert: pet-toon-vs:vert
      frag: pet-toon-fs:frag
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties: *props
}%

CCProgram pet-toon-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <builtin/functionalities/world-transform>
  #include <legacy/local-batch>

  out vec3 v_worldNormal;
  out vec3 v_worldPos;

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec4 worldPos = matWorld * In.position;
    v_worldPos = worldPos.xyz;
    v_worldNormal = normalize((matWorldIT * vec4(In.normal, 0.0)).xyz);
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram pet-toon-fs %{
  precision highp float;
  #include <legacy/output-standard>
  #include <builtin/uniforms/cc-global>

  in vec3 v_worldNormal;
  in vec3 v_worldPos;

  uniform Constant {
    vec4 mainColor;
    vec4 shadeColor;
    vec4 lightDir;
    vec4 shadeCtrl;
    vec4 rimColor;
    vec4 furColor;
    vec4 furCtrl;
  };

  vec4 frag () {
    vec3 n = normalize(v_worldNormal);
    vec3 l = normalize(lightDir.xyz);
    vec3 v = normalize(cc_cameraPos.xyz - v_worldPos);

    // 半兰伯特 + 宽羽化：明暗过渡柔和（参考图没有硬色阶）
    float ndl = dot(n, l) * 0.5 + 0.5;
    float lit = smoothstep(shadeCtrl.x - shadeCtrl.y, shadeCtrl.x + shadeCtrl.y, ndl);

    vec3 col = mix(shadeColor.rgb, mainColor.rgb, lit);
    // 顶部天光提亮（圆润形体的上亮下暗）
    col += mainColor.rgb * clamp(n.y, 0.0, 1.0) * shadeCtrl.w;
    // 环境补光：面向相机的一侧微微提亮，避免背光面死板
    col += mainColor.rgb * pow(clamp(dot(n, v), 0.0, 1.0), 3.0) * 0.06;

    // 点高光（光滑物种：塑料/陶瓷湿润感）
    vec3 h = normalize(l + v);
    float spec = pow(max(dot(n, h), 0.0), max(furCtrl.w, 1.0)) * furCtrl.z;
    col += vec3(spec);

    // 轮廓光：让角色从背景中"浮"出来
    float edge = 1.0 - clamp(dot(n, v), 0.0, 1.0);
    float rim = pow(edge, 2.6) * shadeCtrl.z;
    col += rimColor.rgb * rim;

    // 底部环境遮蔽：形体下半部压暗，塑造柔软绒毛/软陶的体积感（避免"纸片感"）
    col *= mix(0.84, 1.0, clamp(n.y * 0.5 + 0.5, 0.0, 1.0));

    // 绒光：边缘透光（模拟绒毛边缘散射），向上的一侧更强
    float fur = pow(edge, furCtrl.y) * furCtrl.x * (0.65 + 0.35 * clamp(n.y, 0.0, 1.0));
    col += furColor.rgb * fur;

    return CCFragOutput(vec4(col, mainColor.a));
  }
}%

CCProgram pet-outline-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <builtin/functionalities/world-transform>
  #include <legacy/local-batch>

  uniform OutlineParams {
    vec4 outlineCtrl;
    vec4 outlineColor;
  };

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    // 沿顶点法线外扩（模型空间；宽度由 JS 侧按部件尺度下发）
    In.position.xyz += normalize(In.normal) * outlineCtrl.x;

    mat4 matWorld;
    CCGetWorldMatrix(matWorld);
    return cc_matProj * (cc_matView * matWorld) * In.position;
  }
}%

CCProgram pet-outline-fs %{
  precision highp float;
  #include <legacy/output-standard>

  uniform OutlineParams {
    vec4 outlineCtrl;
    vec4 outlineColor;
  };

  vec4 frag () {
    return CCFragOutput(vec4(outlineColor.rgb, 1.0));
  }
}%
