datasource db {
  provider = "sqlite"
  url      = "file:./bff.db"
}

generator client {
  provider = "prisma-client-js"
}

model BffCache {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateLimitCounter {
  id           Int      @id @default(autoincrement())
  identifier   String
  requestCount Int      @default(1)
  windowStart  DateTime
  createdAt    DateTime @default(now())
}
