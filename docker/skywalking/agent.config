# SkyWalking Agent 配置文件
# 此文件放置在 skywalking-agent/config/ 目录下
# agent jar 下载地址: https://archive.apache.org/dist/skywalking/java-agent/10.4.0/
# 解压后将 skywalking-agent.jar 路径配置到启动脚本中

# 服务名称（启动时通过 -Dskywalking.agent.service_name 覆盖）
agent.service_name=${SW_SERVICE_NAME:mall-default}

# OAP 后端地址（启动时通过 -Dskywalking.collector.backend_service 覆盖）
collector.backend_service=${SW_OAP_ADDR:127.0.0.1:11800}

# 采样率（-1 表示全采样，生产环境建议 1000 表示每秒采样 1000 条）
agent.sample_n_per_3_secs=${SW_SAMPLE_RATE:-1}

# 忽略的路径（健康检查等不需要 trace）
agent.ignore_suffix=${SW_IGNORE_SUFFIX:.jpg,.jpeg,.png,.gif,.css,.js,.ico,.woff,.woff2,.svg,.actuator,.health}

# 日志级别：DEBUG / INFO / WARN / ERROR
logging.level=${SW_LOG_LEVEL:INFO}
logging.file_name=${SW_LOG_FILE:skywalking-api.log}

# 插件配置
plugin.mount=plugins,bootstrap-plugins,optional-plugins

# Spring Cloud 插件
plugin.spring_cloud.feign.enable=${SW_PLUGIN_FEIGN:true}
plugin.spring_cloud.gateway.enable=${SW_PLUGIN_GATEWAY:true}
plugin.springmvc.collect_http_params=${SW_COLLECT_HTTP_PARAMS:true}

# 数据库插件
plugin.mysql.trace_sql_parameter=${SW_TRACE_SQL_PARAM:true}
plugin.mybatis.trace_sql_parameter=${SW_TRACE_SQL_PARAM:true}

# Redis 插件
plugin.redis.trace_parameters=${SW_TRACE_REDIS_PARAMS:false}

# RocketMQ 插件
plugin.rocketmq.collect_message_parameters=${SW_COLLECT_MQ_PARAMS:true}

# 排除插件（可选）
# plugin.exclude_plugins=micrometer-1.0
