# ===========================================
# CloudMart 生产环境变量模板（P2-21 上线检查单）
# 用法：复制为 .env.production 并注入真实值；严禁把真实口令提交仓库。
# 部署时逐项核对 docs/CloudMart全栈审计与改造实施方案.md §10 检查单。
# ===========================================

# --- 网关 CORS（必改：注入真实域名，逗号分隔；缺省的 localhost 只用于本地） ---
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# --- API 文档外泄关闭（P2-21：生产双开关置 false；dev/test 保持默认 true） ---
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# --- 基础设施口令（全部环境变量注入，不落仓库；下方为占位符） ---
MYSQL_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__
NACOS_PASSWORD=__CHANGE_ME__
NACOS_AUTH_TOKEN=__CHANGE_ME__
SEATA_SECRET_KEY=__CHANGE_ME__
XXL_JOB_ACCESS_TOKEN=__CHANGE_ME__

# --- 基础设施地址（生产内网域名/地址） ---
NACOS_SERVER_ADDR=nacos:8848
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
SEATA_SERVER_ADDR=seata:8091
ELASTICSEARCH_URIS=http://elasticsearch:9200

# --- 日志级别（yml 默认已 INFO；如需临时排障再覆盖） ---
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_CLOUD_OPENFEIGN=DEBUG

# --- 文件存储（P1-19 MinIO 生产化） ---
FILE_STORAGE_MODE=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=https://files.your-domain.com
MINIO_ACCESS_KEY=__CHANGE_ME__
MINIO_SECRET_KEY=__CHANGE_ME__
MINIO_BUCKET=cloudmart-files

# --- 微信支付（P0-1 启用时；渠道凭据一律环境变量，禁止入库） ---
# WECHAT_PAY_MCH_ID=__CHANGE_ME__
# WECHAT_PAY_MCH_SERIAL_NO=__CHANGE_ME__
# WECHAT_PAY_API_V3_KEY=__CHANGE_ME__
# WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat_pay_private_key.pem
# WECHAT_PAY_APPID=__CHANGE_ME__
# WECHAT_PAY_NOTIFY_DOMAIN=https://your-domain.com
