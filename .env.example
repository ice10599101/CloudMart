# CloudMart 本地启动参数模板。复制为 .env；业务运行变量统一在 Nacos 维护。
# public / DEFAULT_GROUP / shared-runtime.yml；服务专用配置 mall-<service>.yml 优先。
# 完整清单：docs/ENVIRONMENT_VARIABLES.csv；说明：docs/NACOS_CONFIGURATION.md。

# 客户端连接入口：必须先知道地址和凭据，才能加载 Nacos 配置。
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=

# Docker 基础设施启动参数：Docker Compose 不直接消费 Spring/Nacos 配置。
NACOS_AUTH_TOKEN=your_nacos_auth_token_base64
SEATA_SECRET_KEY=your_seata_secret_key
MYSQL_HOST=127.0.0.1
MYSQL_PORT=8306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
SEATA_IP=127.0.0.1
BROKER_IP=127.0.0.1

# Java Agent 及前端构建参数。
SW_OAP_ADDR=127.0.0.1:11800
SW_SERVICE_NAME=mall-default
EXPO_PUBLIC_API_HOST=http://127.0.0.1

# MAIL、文件签名、服务令牌、AI、Redis、MQ、天气等业务变量统一在 Nacos 维护。
# MYSQL_* 同时用于 Docker/数据库维护工具；服务启动脚本屏蔽业务环境变量，
# 业务数据库连接读取 shared-runtime.yml 中的 MYSQL_*。
