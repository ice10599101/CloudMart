# ===========================================
# CloudMart 环境变量配置模板
# 使用方法：复制此文件为 .env，填入真实值后导入到当前 Shell
#   PowerShell: Get-Content .env | ForEach-Object { ... }
#   或直接在系统环境变量中配置（推荐生产环境）
# 默认值见各模块 application.yml 中的 ${VAR:default} 写法
# ===========================================

# --- 阿里云 OSS 文件存储（mall-file）---
OSS_ACCESS_KEY=your_oss_access_key
OSS_SECRET_KEY=your_oss_secret_key
OSS_END_POINT=oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_bucket_name
OSS_DOMAIN=https://your_bucket.oss-cn-guangzhou.aliyuncs.com/

# --- Nacos 认证 Token（Base64，至少 32 字符，docker-compose 用）---
NACOS_AUTH_TOKEN=your_nacos_auth_token_base64

# --- Seata 认证密钥（docker/seata/config/application.yml 用）---
SEATA_SECRET_KEY=your_seata_secret_key

# --- 阿里云 DashScope AI API Key（mall-ai 用）---
DASHSCOPE_API_KEY=sk-your_dashscope_api_key

# --- Elasticsearch（mall-ai 用，未启用安全时留空）---
ELASTICSEARCH_URIS=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=

# --- 基础设施地址（按实际部署填写，本地默认 127.0.0.1）---
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=8306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
REDIS_HOST=127.0.0.1
REDIS_PORT=8379
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
SEATA_SERVER_ADDR=127.0.0.1:8091
SEATA_IP=127.0.0.1
BROKER_IP=127.0.0.1

# --- SkyWalking Agent（docker/skywalking/agent.config 用）---
SW_OAP_ADDR=127.0.0.1:11800
SW_SERVICE_NAME=mall-default

# --- Gateway CORS 白名单（逗号分隔）---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,http://localhost:8081,http://localhost:10086

# --- Expo 移动端 API 地址（Native 模式用，Web 模式自动取当前 hostname）---
EXPO_PUBLIC_API_HOST=http://127.0.0.1
